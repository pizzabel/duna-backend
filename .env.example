# D-una · Variables de entorno
# Copia este archivo como .env y rellena los valores reales
# NUNCA subas .env a git — está en .gitignore

# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# ── Base de datos ────────────────────────────────────────────
# PostgreSQL 16 con PostGIS — Railway provee esta URL automáticamente
DATABASE_URL=postgresql://duna:password@localhost:5432/duna_dev?schema=public

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ──────────────────────────────────────────────────────
# Genera con: openssl rand -hex 64
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRET_SEGURO_DE_64_BYTES
JWT_REFRESH_SECRET=CAMBIA_ESTO_POR_OTRO_SECRET_DIFERENTE_DE_64_BYTES

# ── Twilio (OTP por SMS) ─────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+15005550006   # número sandbox de Twilio

# ── MercadoPago (pagos Colombia) ─────────────────────────────
# Obtener en: mercadopago.com.co/developers → Credenciales
# Sandbox: empieza con TEST-
# Producción: empieza con APP_USR-
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MP_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Wompi (fallback, opcional) ───────────────────────────────
# Sandbox: https://developers.wompi.co/
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_PRIVATE_KEY=prv_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_EVENTS_SECRET=test_events_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── AWS S3 (imágenes de publicaciones) ──────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
S3_BUCKET=duna-posts-dev
CLOUDFRONT_URL=https://xxxxxxxx.cloudfront.net

# ── SendGrid (emails transaccionales) ────────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@duna.app

# ── Sentry (observabilidad) ───────────────────────────────────
SENTRY_DSN=https://xxxxxxxx@oxxxxxxxx.ingest.sentry.io/xxxxxxxx

# ── Rate limiting ────────────────────────────────────────────
RATE_LIMIT_MAX=100   # requests por minuto por IP
